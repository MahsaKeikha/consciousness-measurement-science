{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/consciousness-measurement/claim.schema.json",
  "title": "Consciousness Measurement Scientific Claim",
  "description": "Machine-readable record for an M0-M7 scientific claim in the consciousness measurement program.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "target",
    "statement",
    "claim_level",
    "population",
    "contexts",
    "evidence",
    "assumptions",
    "identifiability",
    "external_validation",
    "falsification_condition",
    "nonclaims",
    "status"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "enum": [
        "presence",
        "global_state",
        "content",
        "structure",
        "capacity",
        "theory_comparison"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "claim_level": {
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7"]
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasets", "analyses"],
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analyses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]+$"
      }
    },
    "identifiability": {
      "enum": ["point", "interval", "partial", "not_identified"]
    },
    "external_validation": {
      "type": "boolean"
    },
    "falsification_condition": {
      "type": "string",
      "minLength": 1
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": ["proposed", "preregistered", "supported", "failed", "inconclusive"]
    },
    "preregistration": {
      "type": ["string", "null"]
    },
    "code_commit": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": "string"
    }
  }
}
